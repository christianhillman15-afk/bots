# ─────────────────────────────────────────────────────────────
#  Launch Media Prospector — configuration
#  Copy this file to ".env" and fill in your keys.
#  With NO keys set, the tool runs in DEMO mode (realistic sample
#  data) so you can see the full pipeline before paying for anything.
# ─────────────────────────────────────────────────────────────

# Google Places API (New) key — the lead SOURCE.
# Get one: https://console.cloud.google.com/  -> enable "Places API (New)"
# Without this, the tool uses the built-in demo dataset.
GOOGLE_PLACES_API_KEY=

# Google PageSpeed Insights API key — optional, deepens website audits
# (real Lighthouse performance/SEO/mobile scores). Free tier works without a
# key but is heavily rate-limited; a key raises the quota.
# Get one: https://console.cloud.google.com/  -> enable "PageSpeed Insights API"
PAGESPEED_API_KEY=

# "Verify websites" searches the live web (by company name + phone) to catch
# real sites Google Places didn't list, so "no website" leads are accurate.
# Use EITHER of these — Claude is used if both are set:
#
# Claude (recommended) — uses Claude's web search tool. Get a key at
# https://console.anthropic.com  (enable Web Search in Console → Privacy/settings)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
#
# Gemini (alternative) — Google Search grounding. Free key at https://aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
#
# Hard safety cap on web searches (website-verify + owner lookup share this
# count) so you never spill past the provider's FREE grounding allowance and get
# billed. Gemini 2.5 free grounding is DAILY (1,500/day, billed per lead), so the
# default is a conservative daily cap of 1,400.
#   SEARCH_CAP=1400            # max searches per period (0 disables the cap)
#   SEARCH_CAP_PERIOD=day      # 'day' (Gemini 2.5) or 'month' (Gemini 3.x)
# For Gemini 3.x (5,000/mo, billed per query) use: GEMINI_MODEL=gemini-3.5-flash,
# SEARCH_CAP_PERIOD=month, SEARCH_CAP=1500.
# SEARCH_CAP=1400
# SEARCH_CAP_PERIOD=day

# ── Special Requests enrichment sources (all OPTIONAL, key-gated) ────────────
# Used by the "Special Requests" tab to find websites/owners/emails and to
# refine revenue estimates. The tab works without any of these; they just add
# accuracy and coverage when set.
#
# Google Programmable Search (Custom Search JSON API) — structured web results
# for website/owner/email lookup. 100 queries/day free, then ~$5/1,000. Needs
# BOTH an API key AND a Search-Engine ID (cx) from a Programmable Search Engine
# configured to "search the entire web". https://programmablesearchengine.google.com
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
#
# Crunchbase — estimated revenue RANGE for private companies it covers.
CRUNCHBASE_API_KEY=
#
# SEC EDGAR — exact reported revenue for PUBLIC US companies (free, no key).
# Off by default (local trades are private). Set EDGAR_ENABLED=true for
# big/public-company runs. SEC asks for a descriptive contact User-Agent.
# EDGAR_ENABLED=false
# EDGAR_USER_AGENT=Launch Media Prospector christian@wearelaunchmedia.com

# How deeply to audit existing websites:
#   light   = fast HTTP/SSL/mobile/title checks only (no PageSpeed, no quota cost)
#   full    = light checks + PageSpeed Insights Lighthouse scores (slower)
AUDIT_MODE=light

# Dashboard server port (hosts like Render/Railway set this automatically)
PORT=4317

# Dashboard login. LEAVE BLANK for private/local use. SET A PASSWORD before
# hosting the dashboard anywhere reachable on the internet, so only you (and
# anyone you share the password with) can view leads or trigger scans.
DASHBOARD_USER=surge
DASHBOARD_PASSWORD=

# Where leads are stored. Leave blank to use ./data. On a host, point this at a
# mounted persistent disk (e.g. /data) so your leads + statuses survive restarts.
DATA_DIR=

# Identify our auditor politely to the sites we fetch
AUDIT_USER_AGENT=LaunchMediaProspectorBot/1.0 (+https://wearelaunchmedia.com; website quality audit)

# Max concurrent website audits (be a good citizen)
AUDIT_CONCURRENCY=6

# Per-site fetch timeout, milliseconds
AUDIT_TIMEOUT_MS=12000
