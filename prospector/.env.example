# ─────────────────────────────────────────────────────────────
#  Launch Media Prospector — configuration
#  Copy this file to ".env" and fill in your keys.
#  With NO keys set, the tool runs in DEMO mode (realistic sample
#  data) so you can see the full pipeline before paying for anything.
# ─────────────────────────────────────────────────────────────

# Google Places API (New) key — the lead SOURCE.
# Get one: https://console.cloud.google.com/  -> enable "Places API (New)"
# Without this, the tool uses the built-in demo dataset.
GOOGLE_PLACES_API_KEY=

# Google PageSpeed Insights API key — optional, deepens website audits
# (real Lighthouse performance/SEO/mobile scores). Free tier works without a
# key but is heavily rate-limited; a key raises the quota.
# Get one: https://console.cloud.google.com/  -> enable "PageSpeed Insights API"
PAGESPEED_API_KEY=

# "Verify websites" searches the live web (by company name + phone) to catch
# real sites Google Places didn't list, so "no website" leads are accurate.
# Use EITHER of these — Claude is used if both are set:
#
# Claude (recommended) — uses Claude's web search tool. Get a key at
# https://console.anthropic.com  (enable Web Search in Console → Privacy/settings)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
#
# Gemini (alternative) — Google Search grounding. Free key at https://aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
#
# Hard safety cap on web searches (website-verify + owner lookup share this
# count) so you never spill past the provider's FREE grounding allowance and get
# billed. Gemini 2.5 free grounding is DAILY (1,500/day, billed per lead), so the
# default is a conservative daily cap of 1,400.
#   SEARCH_CAP=1400            # max searches per period (0 disables the cap)
#   SEARCH_CAP_PERIOD=day      # 'day' (Gemini 2.5) or 'month' (Gemini 3.x)
# For Gemini 3.x (5,000/mo, billed per query) use: GEMINI_MODEL=gemini-3.5-flash,
# SEARCH_CAP_PERIOD=month, SEARCH_CAP=1500.
# SEARCH_CAP=1400
# SEARCH_CAP_PERIOD=day

# ── Special Requests enrichment sources (all OPTIONAL, key-gated) ────────────
# Used by the "Special Requests" tab to find websites/owners/emails and to
# refine revenue estimates. The tab works without any of these; they just add
# accuracy and coverage when set.
#
# Google Programmable Search (Custom Search JSON API) — structured web results
# for website/owner/email lookup. 100 queries/day free, then ~$5/1,000. Needs
# BOTH an API key AND a Search-Engine ID (cx) from a Programmable Search Engine
# configured to "search the entire web". https://programmablesearchengine.google.com
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
#
# Crunchbase — estimated revenue RANGE for private companies it covers.
CRUNCHBASE_API_KEY=
#
# SEC EDGAR — exact reported revenue for PUBLIC US companies (free, no key).
# Off by default (local trades are private). Set EDGAR_ENABLED=true for
# big/public-company runs. SEC asks for a descriptive contact User-Agent.
# EDGAR_ENABLED=false
# EDGAR_USER_AGENT=Launch Media Prospector christian@wearelaunchmedia.com
#
# Twilio Lookup — line-type (mobile vs landline) so Daily Phones skips landlines
# and cold SMS only hits textable mobiles. ~$0.008/number. From console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# HARD daily ceiling on Twilio lookups — cannot be exceeded no matter what
# (default 1,000/day ≈ $8/day max). Raise only if you deliberately need a bigger
# one-time batch. This is your in-app runaway-cost guard.
# TWILIO_DAILY_LOOKUP_CAP=1000
#
# Apollo.io — owner/decision-maker names + direct email & phone (best owner
# source for local businesses). Free tier with monthly credits. From apollo.io
APOLLO_API_KEY=

# HARD daily cap on Google Places search requests — applies to BOTH the
# always-on droplet auto-scanner AND the cloud hunt, so neither can ever bill
# past a safe daily rate. Default 30/day (~900/mo) stays inside the ~1,000/mo
# free tier for the website/rating search SKU. Once hit, scanning pauses until
# tomorrow. The TRUE guarantee is a daily quota set on the Places API in Google
# Cloud itself — this is the in-app companion. Raise it only with billing set up.
# PLACES_DAILY_CALL_CAP=30

# ── FREE lead-discovery sources (no key, on by default) ─────────────────────
# These find businesses at $0 cost so the scanner can run all day without ever
# touching the paid Google Places SKU. Google Places is deliberately NOT in the
# default source list — add it below only if you want it as a gap-filler.
#   OVERPASS — OpenStreetMap (nationwide, no key). Radius around each metro.
# OVERPASS_ENABLED=true
# OVERPASS_RADIUS_MI=25
#   SOCRATA — government open-data license datasets. Works with no key; a free
#   app token (console at your data portal) just raises rate limits.
# SOCRATA_ENABLED=true
# SOCRATA_APP_TOKEN=
#   ARCGIS — government ArcGIS FeatureServer license datasets (no key).
# ARCGIS_ENABLED=true
#   Ordered discovery sources the scanner uses. Leave google-places OUT to keep
#   the always-on scan 100% free; add it (and set a key) to gap-fill with Google.
# DISCOVERY_SOURCES=overpass,socrata,arcgis

# ── Stripe — the ONLY place customer cards are handled ──────────────────────
# When set, the "Create Customer" flow can generate a secure Stripe payment/
# subscription link. The customer enters their card on Stripe's hosted page —
# the card NEVER touches this app or its database (no PCI liability). Get these
# from your Stripe dashboard (dashboard.stripe.com → Developers → API keys, and
# Products → your monthly plan → price ID). Leave blank until you have them.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=

# ── Netlify — auto-publish a generated demo website for a lead ───────────────
# The "🌐 Create Website" button builds a professional one-pager from the lead's
# real info and publishes it live to your Netlify account (each business gets a
# different look). Get a token: Netlify → User settings → Applications →
# Personal access tokens. Secret — keep it here / in the droplet .env only.
NETLIFY_TOKEN=

# ── Supabase — durable cloud database for your leads ────────────────────────
# Moves leads off the fragile local JSON file into managed Postgres: no more
# out-of-memory crashes, and your leads survive any server death. The SERVICE
# key is SECRET (full DB access) — keep it here / in GitHub Secrets, never in
# code. From Supabase → Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# How deeply to audit existing websites:
#   light   = fast HTTP/SSL/mobile/title checks only (no PageSpeed, no quota cost)
#   full    = light checks + PageSpeed Insights Lighthouse scores (slower)
AUDIT_MODE=light

# Dashboard server port (hosts like Render/Railway set this automatically)
PORT=4317

# Dashboard login. LEAVE BLANK for private/local use. SET A PASSWORD before
# hosting the dashboard anywhere reachable on the internet, so only you (and
# anyone you share the password with) can view leads or trigger scans.
DASHBOARD_USER=surge
DASHBOARD_PASSWORD=

# Where leads are stored. Leave blank to use ./data. On a host, point this at a
# mounted persistent disk (e.g. /data) so your leads + statuses survive restarts.
DATA_DIR=

# Identify our auditor politely to the sites we fetch
AUDIT_USER_AGENT=LaunchMediaProspectorBot/1.0 (+https://wearelaunchmedia.com; website quality audit)

# Max concurrent website audits (be a good citizen)
AUDIT_CONCURRENCY=6

# Per-site fetch timeout, milliseconds
AUDIT_TIMEOUT_MS=12000
