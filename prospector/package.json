  "description": "Finds US businesses with no website (or a broken/bad one) that look established enough to afford Oxsome — a lead-finding engine for the website + SEO retainer agency.",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "bin": {
    "prospector": "bin/prospector.js"
  },
  "scripts": {
    "test": "node --test",
  "scan": "node bin/prospector.js scan",
    "list": "node bin/prospector.js list",
    "export": "node bin/prospector.js export",
    "stats": "node bin/prospector.js stats",
    "serve": "node bin/prospector.js serve",
    "start": "node bin/prospector.js serve",
    "sync-supabase": "node bin/prospector.js sync-supabase",
    "hunt-cloud": "node bin/hunt-cloud.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "license": "UNLICENSED",
